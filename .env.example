# ============================================================
# SISTEMAIA — Patrimonio Gastronómico de Ciudad Juárez
# Copia este archivo a .env y rellena los valores reales.
# NUNCA subas el archivo .env real al repositorio.
# ============================================================

# ---------- Supabase ----------
SUPABASE_URL=https://tu-proyecto.supabase.co
# Clave pública (anon): usada por el frontend si se requiere
SUPABASE_ANON_KEY=eyJhbGciOi...
# Clave de servicio: SOLO backend. Bypass de RLS. Nunca exponer.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---------- Backend API ----------
NODE_ENV=development
PORT=4000
# URL del frontend (para CORS)
CLIENT_URL=http://localhost:5173
# Secreto para firmar JWT (usa un string largo y aleatorio)
JWT_SECRET=CAMBIA_ESTE_SECRETO_POR_UNO_LARGO_Y_ALEATORIO
# Expiración del token
JWT_EXPIRES_IN=7d

# ---------- Rate limiting (balance de cargas) ----------
# Máximo de peticiones por ventana por IP
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
# Límite más estricto para endpoints de autenticación
AUTH_RATE_LIMIT_MAX=10

# ---------- Vercel Services ----------
# No definas PUBLIC_API_URL en producción: el frontend usa /api-proxy, que
# llama al servicio api mediante el binding interno API_INTERNAL_URL.
# Para desarrollo local de apps/web usa PUBLIC_API_URL=http://localhost:4000/api
